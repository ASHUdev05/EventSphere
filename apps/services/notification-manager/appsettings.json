{
  "Spring": {
    "Application": {
      "Name": "NOTIFICATION-MANAGER"
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:6969/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true
    },
    "Instance": {
      "AppName": "NOTIFICATION-MANAGER",
      "HostName": "localhost",
      "Port": 5277,
      "PreferIPAddress": false
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=notification-manager;Username=postgres;Password=admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AspNetCore": {
    "OpenApi": {
      "DocumentRoute": "/v3/api-docs"
    }
  },
  "AllowedHosts": "*"
}
